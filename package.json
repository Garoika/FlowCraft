{
  "name": "flowcraft",
  "version": "1.0.0",
  "description": "Custom Flowchart Engine and MCP Server for AI Agents with Real-Time Human Control",
  "main": "dist/index.js",
  "bin": {
    "flowcraft": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:win": "node scripts/build-win.js",
    "build:linux": "node scripts/build-linux.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "keywords": [
    "mcp",
